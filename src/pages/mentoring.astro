    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- 1. Zoryan UK -->
      <div class="border border-gray-200 dark:border-gray-700 rounded-xl p-6 bg-white dark:bg-slate-800 shadow-sm">
