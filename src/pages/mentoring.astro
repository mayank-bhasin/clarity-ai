---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Stats from '~/components/widgets/Stats.astro';

const metadata = {
  title: 'Mentoring — Clarity AI',
  description:
    'AI and Product Management mentoring for students, early-career professionals, and experienced leaders pivoting into AI roles.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero tagline="Mentoring">
    <Fragment slot="title">
      <div class="flex justify-center mb-4">
        <img
          src="/images/mayank-bhasin-profile.jpg"
          alt="Mayank Bhasin"
          class="w-28 h-28 rounded-full object-cover border-4 border-blue-500 shadow-lg"
          loading="eager"
        />
      </div>
      Your AI & Product Management
      <span class="text-accent"> Mentor</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="text-lg block mb-3">
        A seasoned mentor active across paid expert platforms, training partners, and volunteer communities — supporting
        professionals at every stage of their AI and product careers.
      </span>
      <span class="text-base text-muted">
        Whether you're a student exploring AI, an early-career PM building your foundation, or an experienced leader
        pivoting into AI — I'll help you navigate the path with clarity and confidence.
      </span>
    </Fragment>
  </Hero>

  <!-- Stats -->
  <Stats
    stats={[
      { title: 'Years of Experience', amount: '21+' },
      { title: 'Microsoft Role', amount: 'Principal PM' },
      { title: 'Mentor', amount: 'Global' },
      { title: 'Companies', amount: 'Microsoft, Nokia, Oracle' },
    ]}
  />

  <!-- Community Recognition Badges -->
  <section class="px-4 py-16 mx-auto max-w-6xl">
    <div class="text-center mb-10">
      <p class="text-base text-secondary dark:text-blue-200 font-semibold tracking-wide uppercase mb-2">
        Community Recognition
      </p>
      <h2 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-white">
        Recognised by the <span class="text-accent">Global Mentoring Community</span>
      </h2>
      <p class="max-w-2xl mx-auto text-lg text-muted dark:text-slate-400">
        Awarded badges from ADPList — the world's largest mentoring community of 250,000+ mentees.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Top 1% Mentor -->
      <div
        class="relative border-2 border-amber-300 dark:border-amber-600 rounded-2xl p-7 bg-gradient-to-br from-amber-50 to-yellow-50 dark:from-amber-900/20 dark:to-yellow-900/10 shadow-md hover:shadow-lg transition text-center"
      >
        <div class="text-5xl mb-3">🏆</div>
        <div class="text-xl font-bold text-amber-900 dark:text-amber-100 mb-1">Top 1% Mentor</div>
        <div class="text-sm text-amber-700 dark:text-amber-300 font-medium mb-2">April 2026</div>
        <div class="text-xs text-muted dark:text-slate-400 uppercase tracking-wider">ADPList</div>
      </div>

      <!-- Top 10 Mentor -->
      <div
        class="relative border-2 border-amber-300 dark:border-amber-600 rounded-2xl p-7 bg-gradient-to-br from-amber-50 to-yellow-50 dark:from-amber-900/20 dark:to-yellow-900/10 shadow-md hover:shadow-lg transition text-center"
      >
        <div class="text-5xl mb-3">🥇</div>
        <div class="text-xl font-bold text-amber-900 dark:text-amber-100 mb-1">Top 10 Mentor</div>
        <div class="text-sm text-amber-700 dark:text-amber-300 font-medium mb-2">March 2026</div>
        <div class="text-xs text-muted dark:text-slate-400 uppercase tracking-wider">ADPList</div>
      </div>

      <!-- Top 10 Fresh in AI/ML Engineering -->
      <div
        class="relative border-2 border-amber-400 dark:border-amber-500 rounded-2xl p-7 bg-gradient-to-br from-yellow-50 to-amber-100 dark:from-amber-900/30 dark:to-yellow-900/20 shadow-md hover:shadow-lg transition text-center"
      >
        <div class="text-5xl mb-3">🥇</div>
        <div class="text-xl font-bold text-amber-900 dark:text-amber-100 mb-1">Top 10 Fresh in AI/ML Engineering</div>
        <div class="text-sm text-amber-700 dark:text-amber-300 font-medium mb-2">Jan – Mar 2026</div>
        <div class="text-xs text-muted dark:text-slate-400 uppercase tracking-wider">ADPList Golden Trophy</div>
      </div>
    </div>
  </section>

  <!-- Who Is This For -->
  <Features
    id="who"
    tagline="Who Is This For"
    title="Mentoring for Every Stage of Your AI & PM Journey"
    subtitle="I work with people at different career stages, each with unique needs and goals."
    items={[
      {
        title: 'Students & Graduates',
        description:
          'Exploring careers in AI, product management, or tech. Get clarity on career paths, build the right skills, and prepare for your first role in AI or PM.',
        icon: 'tabler:school',
      },
      {
        title: 'Early-Career Professionals (0–5 years)',
        description:
          'Building your PM or AI foundations. Develop strategic thinking, learn AI tools hands-on, understand agentic AI, and accelerate your career growth.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Experienced Leaders Pivoting to AI',
        description:
          'Moving into AI product management, GenAI strategy, or agentic AI roles. Leverage your existing experience and reposition for AI-first leadership roles.',
        icon: 'tabler:arrows-exchange',
      },
      {
        title: 'Career Changers & Migrants',
        description:
          'Navigating the UK tech industry from a different background or country. Build your network, understand the landscape, and land your target role.',
        icon: 'tabler:world',
      },
      {
        title: 'Aspiring Product Managers',
        description:
          'Transitioning into product management from engineering, design, or business roles. Learn PM frameworks, build your portfolio, and ace interviews.',
        icon: 'tabler:target',
      },
      {
        title: 'Women in Tech',
        description:
          'Breaking barriers and building leadership careers. Get support on navigating growth, visibility, and leadership development in tech.',
        icon: 'tabler:heart-handshake',
      },
    ]}
  />

  <!-- How It Works -->
  <Steps
    title="How Mentoring Works"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Book a Free Discovery Call</span>',
        description:
          'We start with a free 15-minute call to understand your goals, challenges, and where you are in your career journey. No commitment required.',
        icon: 'tabler:phone',
      },
      {
        title: 'Step 2: <span class="font-medium">Choose Your Package</span>',
        description:
          'Select the mentoring package that fits your needs — from single sessions for quick guidance to ongoing monthly mentoring for deeper transformation.',
        icon: 'tabler:clipboard-list',
      },
      {
        title: 'Step 3: <span class="font-medium">Personalised Mentoring Sessions</span>',
        description:
          'Each session is tailored to you. We work on your specific challenges — career strategy, AI skills, interview prep, product thinking, or leadership development.',
        icon: 'tabler:users',
      },
      {
        title: 'Step 4: <span class="font-medium">Actionable Outcomes</span>',
        description:
          'You leave every session with clear action items, resources, and a plan. I follow up to ensure you are making progress toward your goals.',
        icon: 'tabler:check',
      },
    ]}
  />

  <!-- Pricing -->
  <Pricing
    title="Mentoring Packages"
    subtitle="Flexible options for every stage of your journey"
    tagline="Pricing"
    prices={[
      {
        title: 'Discovery Call',
        subtitle: 'Get started — no commitment',
        price: 'Free',
        period: '15 minutes',
        items: [
          { description: '15-minute video call' },
          { description: 'Discuss your goals & challenges' },
          { description: 'Get initial career direction' },
          { description: 'No obligation to continue' },
        ],
        callToAction: {
          text: 'Book Free Call',
          href: 'https://calendly.com/mayankbhasin007/new-meeting',
          target: '_blank',
        },
      },
      {
        title: 'Clarity Focus Session',
        subtitle: 'Focused guidance on a specific topic',
        price: 50,
        period: '30 minutes',
        items: [
          { description: '30-minute 1:1 video session' },
          { description: 'Career strategy or AI skills focus' },
          { description: 'Actionable takeaways & resources' },
          { description: 'Session notes shared after call' },
        ],
        callToAction: {
          text: 'Buy Focus Session',
          href: 'https://buy.stripe.com/5kQcN4dB0662dit1I52go01',
          target: '_blank',
        },
      },
      {
        title: 'Clarity Deep-Dive',
        subtitle: 'Extended session for complex topics',
        price: 90,
        period: '60 minutes',
        items: [
          { description: '60-minute 1:1 video session' },
          { description: 'Portfolio or CV review included' },
          { description: 'Interview prep or career roadmap' },
          { description: 'Follow-up email with action plan' },
        ],
        callToAction: {
          text: 'Buy Deep-Dive',
          href: 'https://buy.stripe.com/28E28q1SiamiguFfyV2go02',
          target: '_blank',
        },
        hasRibbon: true,
        ribbonTitle: 'Popular',
      },
    ]}
  />

  <Pricing
    title="Career Clarity Programme"
    subtitle="Move from uncertainty to a clear target, stronger positioning, and a practical action plan"
    prices={[
      {
        title: 'Career Clarity Power Pack',
        subtitle: 'Structured support for your next career move',
        price: 249,
        period: 'one-time',
        items: [
          { description: '2x 60-minute 1:1 sessions' },
          { description: 'Career and skills diagnostic' },
          { description: 'Target-role and positioning strategy' },
          { description: 'CV or LinkedIn profile review' },
          { description: 'Personal 30-day action plan' },
          { description: 'Written feedback between sessions' },
        ],
        callToAction: {
          text: 'Buy Career Clarity Pack',
          href: 'https://buy.stripe.com/aFaaEW8gG2TQemxcmJ2go03',
          target: '_blank',
        },
        hasRibbon: true,
        ribbonTitle: 'Outcome Based',
      },
    ]}
  />

  <!-- Additional Package Info -->
  <Pricing
    title="Monthly Mentoring"
    subtitle="For ongoing support and accountability"
    prices={[
      {
        title: 'Starter',
        subtitle: '2 sessions per month',
        price: 150,
        period: 'per month',
        items: [
          { description: '2x 30-minute sessions per month' },
          { description: 'Email support between sessions' },
          { description: 'Resource recommendations' },
          { description: 'Progress tracking' },
        ],
        callToAction: {
          text: 'Start Monthly Plan',
          href: 'https://buy.stripe.com/00w3cu54ufGCcep3Qd2go04',
          target: '_blank',
        },
      },
      {
        title: 'Growth',
        subtitle: '4 sessions per month',
        price: 275,
        period: 'per month',
        items: [
          { description: '4x 30-minute sessions per month' },
          { description: 'Priority email & chat support' },
          { description: 'CV/portfolio review included' },
          { description: 'LinkedIn profile optimisation' },
          { description: 'Mock interview practice' },
        ],
        callToAction: {
          text: 'Start Growth Plan',
          href: 'https://buy.stripe.com/14AdR8cwW0LIbal4Uh2go05',
          target: '_blank',
        },
        hasRibbon: true,
        ribbonTitle: 'Best Value',
      },
      {
        title: 'Executive',
        subtitle: 'For senior leaders pivoting to AI',
        price: 450,
        period: 'per month',
        items: [
          { description: '4x 60-minute sessions per month' },
          { description: 'Unlimited email & chat support' },
          { description: 'AI career transition roadmap' },
          { description: 'Executive positioning strategy' },
          { description: 'Network introductions' },
          { description: 'Personal brand coaching' },
        ],
        callToAction: {
          text: 'Go Executive',
          href: 'https://calendly.com/mayankbhasin007/new-meeting',
          target: '_blank',
        },
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Pricing>

  <section class="px-4 pb-12 mx-auto max-w-4xl text-center">
    <p class="text-sm text-muted">
      Payments are processed securely by Stripe. Monthly plans renew automatically until cancelled. By purchasing, you
      agree to the <a href="/terms" class="text-blue-600 hover:underline">service terms</a>
      and acknowledge the <a href="/privacy" class="text-blue-600 hover:underline">privacy policy</a>. After payment,
      use the booking link in your confirmation to schedule your first session.
    </p>
  </section>

  <!-- What You'll Get -->
  <Features3
    title="What My Mentees Get"
    subtitle="Every engagement is tailored, but these are the core areas I cover"
    columns={3}
    items={[
      {
        title: 'AI & Agentic AI Skills',
        description:
          'Hands-on guidance on LLMs, prompt engineering, RAG, AI agents, Copilot, and how to apply AI in product roles.',
        icon: 'tabler:brain',
      },
      {
        title: 'Product Management Frameworks',
        description: 'Roadmapping, stakeholder management, OKRs, go-to-market strategy, and PM interview prep.',
        icon: 'tabler:layout-dashboard',
      },
      {
        title: 'Career Pivot Strategy',
        description:
          'A clear roadmap to transition into AI or PM roles — which skills to build, certs to get, and how to position yourself.',
        icon: 'tabler:map',
      },
      {
        title: 'CV & Portfolio Review',
        description: 'ATS-optimised CV feedback, LinkedIn profile enhancement, and portfolio building guidance.',
        icon: 'tabler:file-text',
      },
      {
        title: 'Interview Preparation',
        description: 'Mock interviews, case studies, and structured practice for PM, AI, and leadership roles.',
        icon: 'tabler:message-circle',
      },
      {
        title: 'Network & Visibility',
        description:
          'Guidance on building your professional brand, growing your network, and becoming visible in the AI community.',
        icon: 'tabler:share',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-slate-800"></div>
    </Fragment>
  </Features3>

  <!-- Where I Mentor: Full Platform Ecosystem -->
  <section class="px-4 py-16 mx-auto max-w-6xl">
    <div class="text-center mb-12">
      <p class="text-base text-secondary dark:text-blue-200 font-semibold tracking-wide uppercase mb-2">
        Where I Mentor
      </p>
      <h2 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-white">
        Across the Global Mentorship Ecosystem
      </h2>
      <p class="max-w-3xl mx-auto text-lg text-muted dark:text-slate-400">
        From paid expert networks to volunteer communities — a practitioner mentor across the platforms where the global
        PM and AI community actually learns.
      </p>
    </div>

    <!-- Tier 1: Paid Mentoring Platforms -->
    <div class="mb-14">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-300 mb-6 text-center">
        Paid Mentor Across
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- ADPList -->
        <div
          class="border border-gray-200 dark:border-gray-700 rounded-lg p-6 bg-white dark:bg-slate-800 hover:shadow-md hover:border-blue-400 transition"
        >
          <div class="font-bold text-lg mb-2">ADPList</div>
          <p class="text-sm text-muted">
            Global PM and AI mentor — career strategy, AI product transitions, and leadership coaching for product
            professionals.
          </p>
        </div>
        <!-- MentorCruise -->
        <div
          class="border border-gray-200 dark:border-gray-700 rounded-lg p-6 bg-white dark:bg-slate-800 hover:shadow-md hover:border-blue-400 transition"
        >
          <div class="font-bold text-lg mb-2">MentorCruise</div>
          <p class="text-sm text-muted">
            Long-form 1:1 mentorship for aspiring and mid-career PMs — career roadmaps, interview prep, and AI skills.
          </p>
        </div>
        <!-- Topmate -->
        <div
          class="border border-gray-200 dark:border-gray-700 rounded-lg p-6 bg-white dark:bg-slate-800 hover:shadow-md hover:border-blue-400 transition"
        >
          <div class="font-bold text-lg mb-2">Topmate</div>
          <p class="text-sm text-muted">
            1:1 expert calls — rapid problem-solving on PM, AI, and career pivots for the global professional community.
          </p>
        </div>
        <!-- Mentro -->
        <div
          class="border border-gray-200 dark:border-gray-700 rounded-lg p-6 bg-white dark:bg-slate-800 hover:shadow-md hover:border-blue-400 transition"
        >
          <div class="font-bold text-lg mb-2">Mentro</div>
          <p class="text-sm text-muted">
            Structured tech mentorship — skills building, career navigation, and product thinking for early-career
            professionals.
          </p>
        </div>
        <!-- Femme Palette -->
        <div
          class="border border-gray-200 dark:border-gray-700 rounded-lg p-6 bg-white dark:bg-slate-800 hover:shadow-md hover:border-blue-400 transition"
        >
          <div class="font-bold text-lg mb-2">Femme Palette</div>
          <p class="text-sm text-muted">
            Mentor for women in tech — career growth, leadership development, and pivoting into AI and PM roles.
          </p>
        </div>
      </div>
    </div>

    <!-- Tier 2: Training & Career Partners -->
    <div class="mb-14">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-green-600 dark:text-green-300 mb-6 text-center">
        Training &amp; Career Partner
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-3xl mx-auto">
        <!-- BrainStation -->
        <div
          class="border border-gray-200 dark:border-gray-700 rounded-lg p-6 bg-white dark:bg-slate-800 hover:shadow-md hover:border-green-400 transition"
        >
          <div class="font-bold text-lg mb-2">BrainStation</div>
          <p class="text-sm text-muted">
            Lead Instructor — Product Leadership. Training aspiring PMs in strategic thinking and real-world product
            management.
          </p>
        </div>
        <!-- IGotAnOffer -->
        <div
          class="border border-gray-200 dark:border-gray-700 rounded-lg p-6 bg-white dark:bg-slate-800 hover:shadow-md hover:border-green-400 transition"
        >
          <div class="font-bold text-lg mb-2">IGotAnOffer</div>
          <p class="text-sm text-muted">
            Interview coach for PM, leadership, and AI-focused roles — preparing candidates for top-tier tech companies.
          </p>
        </div>
      </div>
    </div>

    <!-- Tier 3: Volunteer Mentorship -->
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wider text-orange-600 dark:text-orange-300 mb-6 text-center">
